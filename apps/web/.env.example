# Absolute origin of the API service (a separate Render deployment from
# this static site). Leave unset in local dev — Vite's own proxy
# (vite.config.ts) already forwards /api/* to the local API server, so a
# relative path resolves correctly without this. Required in production;
# without it, API requests resolve against this site's own origin instead
# of the API's, and silently go nowhere.
VITE_API_URL=https://api.jessicalrobertson.com
