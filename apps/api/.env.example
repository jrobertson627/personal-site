PORT=3001
NODE_ENV=development

# Resend (https://resend.com) — leave RESEND_API_KEY unset to run in
# log-only mode (contact submissions are logged but no email is sent).
RESEND_API_KEY=
CONTACT_TO_EMAIL=jessicarobertson627@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# GitHub REST API username for the "On GitHub" section (#20)
GITHUB_USERNAME=jrobertson627

# Self-hosted telemetry (#21). GET /api/telemetry/summary?key=<this value>
# returns aggregated site stats. Leave unset to keep that endpoint disabled
# (event collection at POST /api/telemetry/event still works either way).
TELEMETRY_ADMIN_KEY=

# CORS (#27). Comma-separated list of origins allowed to call this API.
# Only enforced when NODE_ENV=production — every origin is allowed otherwise.
ALLOWED_ORIGINS=https://jessicalrobertson.com,https://www.jessicalrobertson.com
